# RouteCare local environment example
# Copy to .env.local and fill in real values.

# ----- LLM (optional, natural-language drafting/parsing) -----
ROUTECARE_LLM_API_KEY=
ROUTECARE_LLM_BASE_URL=https://api.openai.com/v1
ROUTECARE_LLM_MODEL=gpt-4o-mini

# ----- SMS delivery (Twilio) -----
ROUTECARE_TWILIO_ACCOUNT_SID=
ROUTECARE_TWILIO_AUTH_TOKEN=
ROUTECARE_TWILIO_FROM_NUMBER=+15551234567
ROUTECARE_TWILIO_BASE_URL=https://api.twilio.com/2010-04-01

# Mailgun webhook signing key (Settings → Webhooks in Mailgun dashboard)
ROUTECARE_MAILGUN_WEBHOOK_SIGNING_KEY=

# ----- Email delivery (SMTP; Mailgun example values) -----
ROUTECARE_MAILER_FROM=care@mg.yourdomain.com
ROUTECARE_SMTP_ADDRESS=smtp.mailgun.org
ROUTECARE_SMTP_PORT=587
ROUTECARE_SMTP_USERNAME=postmaster@mg.yourdomain.com
ROUTECARE_SMTP_PASSWORD=
ROUTECARE_SMTP_DOMAIN=mg.yourdomain.com
ROUTECARE_SMTP_AUTH=plain
ROUTECARE_SMTP_STARTTLS=true

# ----- Database (optional override from config/database.yml) -----
# ROUTECARE_DATABASE_PASSWORD=
