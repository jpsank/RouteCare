# RouteCare local environment example
# Copy to .env.local and fill in real values.

# ----- LLM (optional, natural-language drafting/parsing) -----
ROUTECARE_LLM_API_KEY=
ROUTECARE_LLM_BASE_URL=https://api.openai.com/v1
ROUTECARE_LLM_MODEL=gpt-4o-mini

# ----- App host (used for mailer URLs) -----
ROUTECARE_APP_HOST=localhost:3000

# ----- OAuth sign-in providers (optional) -----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ----- SMS delivery (Telnyx) -----
ROUTECARE_TELNYX_API_KEY=
ROUTECARE_TELNYX_FROM_NUMBER=+15551234567
ROUTECARE_TELNYX_BASE_URL=https://api.telnyx.com/v2
# Ed25519 public key for webhook signature verification (Telnyx dashboard)
ROUTECARE_TELNYX_PUBLIC_KEY=

# ----- Email delivery (Postmark) -----
ROUTECARE_MAILER_FROM=care@yourdomain.com
ROUTECARE_POSTMARK_API_KEY=
# Token for verifying inbound webhook requests
ROUTECARE_POSTMARK_INBOUND_TOKEN=

# ----- Database (optional override from config/database.yml) -----
# ROUTECARE_DATABASE_PASSWORD=
