<div class="flex min-h-screen items-center justify-center bg-gradient-to-b from-slate-50 to-gray-100 px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">RouteCare</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-gray-900">Set new password</h1>
      <p class="mt-1 text-sm text-gray-500">Choose a new password for your account.</p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
        <%= f.hidden_field :reset_password_token %>

        <% if resource.errors.any? %>
          <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            <% resource.errors.full_messages.each do |msg| %>
              <p class="m-0"><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div class="grid gap-1">
          <%= f.label :password, "New password", class: "text-xs font-medium text-gray-500" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-400"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <div class="grid gap-1">
          <%= f.label :password_confirmation, "Confirm password", class: "text-xs font-medium text-gray-500" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022" %>
        </div>

        <%= f.submit "Change password", class: "btn-primary w-full justify-center" %>
      <% end %>
    </div>
  </div>
</div>
