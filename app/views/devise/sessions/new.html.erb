<div class="flex min-h-screen items-center justify-center bg-gradient-to-b from-slate-50 to-gray-100 px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">RouteCare</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-gray-900">Welcome back</h1>
      <p class="mt-1 text-sm text-gray-500">Sign in to manage schedules, routes, and patient outreach.</p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>

        <div class="grid gap-1">
          <%= f.label :email, class: "text-xs font-medium text-gray-500" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
        </div>

        <div class="grid gap-1">
          <div class="flex items-center justify-between">
            <%= f.label :password, class: "text-xs font-medium text-gray-500" %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs font-medium text-indigo-600 hover:text-indigo-800" %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="inline-flex items-center gap-2 text-sm text-gray-600">
            <%= f.check_box :remember_me %>
            Remember me
          </label>
        <% end %>

        <%= f.submit "Sign in", class: "btn-primary w-full justify-center" %>
      <% end %>
    </div>

    <% if devise_mapping.registerable? %>
      <p class="mt-5 text-center text-sm text-gray-500">
        Don't have an account?
        <%= link_to "Create one", new_registration_path(resource_name), class: "font-medium text-indigo-600 hover:text-indigo-800" %>
      </p>
    <% end %>
  </div>
</div>
